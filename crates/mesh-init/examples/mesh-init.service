# mesh-init systemd unit (production installation).
#
# Install the ssh-mesh Nix package first so /opt/ssh-mesh/bin resolves, or
# install release binaries under /opt/ssh-mesh/bin manually:
#   source env.sh && cargo build --release --target x86_64-unknown-linux-musl
#   install -Dm0755 target/x86_64-unknown-linux-musl/release/mesh-init /opt/ssh-mesh/bin/mesh-init
#   install -Dm0755 target/x86_64-unknown-linux-musl/release/mesh /opt/ssh-mesh/bin/mesh
#   install -Dm0755 target/x86_64-unknown-linux-musl/release/ssh-mesh /opt/ssh-mesh/bin/ssh-mesh
#
# Install this unit as root:
#   install -Dm0644 crates/mesh-init/examples/mesh-init.service \
#     /etc/systemd/system/mesh-init.service
#
# Enable and start it:
#   systemctl daemon-reload
#   systemctl enable --now mesh-init.service
#
# Check the daemon:
#   systemctl status mesh-init.service
#   journalctl -u mesh-init.service
#
# Install the post-resume hook on Debian and similar systems:
#   install -Dm0755 \
#     crates/mesh-init/examples/mesh-init-system-sleep \
#     /usr/lib/systemd/system-sleep/mesh-init-reconcile
#
# NixOS should use the declarative mesh-init-resume.nix example instead.

[Unit]
Description=mesh-init service supervisor
After=local-fs.target

[Service]
# mesh-init stays in the foreground and blocks in its control server, so the
# default systemd process model is the correct one. It does not fork or send
# systemd readiness notifications.
Type=simple
ExecStart=/opt/ssh-mesh/bin/mesh-init
WorkingDirectory=/home/system
Environment=HOME=/home/system
# PATH starts with /opt/ssh-mesh/bin so every shipped default executable
# resolves through the stable /opt/ssh-mesh symlink. systemd does not
# expand $PATH in Environment= assignments, so include the normal system
# directories explicitly.
Environment="PATH=/opt/ssh-mesh/bin:/home/system/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/etc/profiles/per-user/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment=RUST_LOG=INFO
Environment=MESH_LOG_DIR=/home/mesh-init/logs
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
