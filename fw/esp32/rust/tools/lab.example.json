      "restore": ["nvs op=set nan.ap_owner=true nan.sync_source=auto", "mode infra=true", "lora rx=true"]
    },
    "lora2": {
      "destination": "lora2.lmesh",
      "capabilities": ["nan", "lora"],
      "reset_on_restore": true,
      "restore": ["nvs op=set nan.ap_owner=false nan.sync_source=auto", "mode infra=true", "lora rx=true"]
    },
    "lora3": {
      "destination": "lora3.lmesh",
      "capabilities": ["nan", "lora"],
      "reset_on_restore": true,
      "restore": ["nvs op=set nan.ap_owner=false nan.sync_source=auto", "mode infra=true", "lora rx=true"]
    },
    "lora4": {
      "destination": "lora4.lmesh",
